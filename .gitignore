# Sentinel-2 source products are large; keep the assignment data local.
*.SAFE/
*.SAFE.zip

# Local and processed geospatial data; keep directory placeholders trackable.
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Generated maps, evidence, reports, and model artifacts.
/outputs/maps/*
!/outputs/maps/.gitkeep
/outputs/evidence/*
!/outputs/evidence/.gitkeep
/outputs/models/*
!/outputs/models/.gitkeep
/outputs/reports/*
!/outputs/reports/.gitkeep
/outputs/processed/*
!/outputs/processed/.gitkeep
/outputs/registered/*
!/outputs/registered/.gitkeep
/outputs/registered_15m/
/outputs/sen2cor/*
!/outputs/sen2cor/.gitkeep

# Model checkpoints and weights.
*.ckpt
*.pt
*.pth
*.safetensors

# Python environments, bytecode, and test/tool caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
