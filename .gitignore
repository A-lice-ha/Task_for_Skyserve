# Sentinel-2 source products are large; keep the assignment data local.
*.SAFE/
*.SAFE.zip

# Local and processed geospatial data; keep directory placeholders trackable.
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/labels/osm/

# Generated maps, evidence, reports, and model artifacts.
/outputs/maps/*
!/outputs/maps/.gitkeep
/outputs/evidence/*
!/outputs/evidence/.gitkeep
/outputs/models/*
!/outputs/models/.gitkeep
/outputs/reports/*
!/outputs/reports/.gitkeep
/outputs/processed/*
!/outputs/processed/.gitkeep
/outputs/registered/*
!/outputs/registered/.gitkeep
/outputs/registered_15m/
/outputs/sen2cor/*
!/outputs/sen2cor/.gitkeep

# Model checkpoints and weights.
*.ckpt
*.pt
*.pth
*.safetensors

# Python environments, bytecode, and test/tool caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Derived training/evaluation intermediates (reproducible from the scripts).
/outputs/patches/
/outputs/weak_labels/*.tif
/outputs/review/
/outputs/quantization/*.onnx
*.log

# Submitted deliverables: final model artifacts, georeferenced change maps
# (class rasters), detection registers and evidence panels.
!/outputs/models/ground_ce_final/
!/outputs/models/onboard_final/
/outputs/models/ground_ce_final/*
/outputs/models/onboard_final/*
!/outputs/models/ground_ce_final/model.pt
!/outputs/models/ground_ce_final/model_fp32.onnx
!/outputs/models/ground_ce_final/model_int8.onnx
!/outputs/models/ground_ce_final/run.json
!/outputs/models/ground_ce_final/quantization.json
!/outputs/models/onboard_final/model.pt
!/outputs/models/onboard_final/model_fp32.onnx
!/outputs/models/onboard_final/model_int8.onnx
!/outputs/models/onboard_final/run.json
!/outputs/models/onboard_final/quantization.json
!/outputs/models/ground_ce_final/window_filter.json
!/outputs/maps/*_ground_fp32_change_class.tif
!/outputs/maps/*_context.tif
!/outputs/maps/*_inference.json
!/outputs/maps/priority_detections_ground_fp32.gpkg
!/outputs/maps/detection_register_ground_fp32.csv
!/outputs/evidence/*.jpg
!/outputs/evidence/README.md
